# =============================================================
# .gitignore — 깃헙에 "올리면 안 되는" 파일 목록
# -------------------------------------------------------------
# 여기 적힌 파일/폴더는 git add . 해도 무시됨.
# ★ 이미 한 번 커밋된 파일은 여기 적어도 계속 추적되니
#   처음부터 잘 적어두는 게 중요함.
# =============================================================

# 파이썬 실행 시 자동 생성되는 캐시 파일 (올릴 필요 없음)
__pycache__/

# 가상환경 폴더 (python -m venv .venv 로 만든 것)
# 용량이 크고, 각자 컴퓨터에서 requirements.txt로 다시 만들면 됨
.venv/

# 환경변수 파일 (DB 비밀번호, API 키 등이 들어가는 곳)
# ★ 이게 깃헙에 올라가면 바로 유출. 비밀번호는 Secret Manager에 넣어야해요
.env

# GCP 서비스 계정 키 파일
# ★ 이게 유출되면 남이 우리 GCP를 마음대로 쓸 수 있음 ~!! 
*.json.key
*-key.json

# 로컬 SQLite DB
*.db
