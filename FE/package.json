    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.21",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "prettier": "3.6.2",
    "typescript": "~6.0.2",
